# Configuração da API Raízes do Nordeste
# Copie este arquivo para ".env" e ajuste os valores conforme o seu ambiente.
# cp .env.example .env

# Aplicação
APP_ENV=local
APP_DEBUG=true
# Caminho-base quando servida pelo Apache em subpasta do htdocs.
# Use string vazia ("") ao rodar com o servidor embutido (php -S).
APP_BASE_PATH=/lorran/apiBackendUninter/public

# Banco de dados (MySQL/MariaDB do XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=raizes_nordeste
DB_USER=root
DB_PASS=

# Autenticação (segredo de assinatura do token — troque em produção)
AUTH_SECRET=troque-este-segredo-em-producao

# Pagamento (gateway externo simulado)
PAYMENT_GATEWAY_URL=http://gateway.simulado.local
PAYMENT_WEBHOOK_SECRET=webhook-secret-simulado
